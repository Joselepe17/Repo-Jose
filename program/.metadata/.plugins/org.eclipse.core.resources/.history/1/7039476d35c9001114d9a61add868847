package arrays;

public class Entrenamiento6 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int [] nums= new int[10];
		for(int i=0; i<10; i++) {
			nums[i]= i*100+1;
		}
		for(int i=(nums.length-1); i>=0; i--) {
			if(i!=0) {
				System.out.println(nums[i]+ "-");
			}
			else if(i==0) {
				System.out.println(nums[i]);
			}
		}
	}

}
